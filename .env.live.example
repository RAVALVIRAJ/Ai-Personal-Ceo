# Backend (Render)
# HTTP port injected by the hosting platform.
PORT=8080
# Direct (non-pooled) Neon JDBC URL; do not include credentials.
DB_URL=jdbc:postgresql://<neon-direct-host>/<database>?sslmode=require
# Database host, used only when DB_URL is unset.
DB_HOST=<neon-direct-host>
# Database port, used only when DB_URL is unset.
DB_PORT=5432
# Database name, used only when DB_URL is unset.
DB_NAME=<database>
# Secret: Neon database username.
DB_USERNAME=<database-username>
# Secret: Neon database password.
DB_PASSWORD=<database-password>
# Maximum backend database connection pool size.
DB_POOL_SIZE=5
# Exact Vercel production origin allowed by the backend.
CORS_ORIGINS=https://<your-project>.vercel.app
# Backend date/time zone.
APP_TIMEZONE=Asia/Kolkata
# Hibernate schema behavior; review before changing production schema.
JPA_DDL_AUTO=update
# Disable SQL statement logging in production.
JPA_SHOW_SQL=false
# Keep reminders disabled until valid SMTP settings are configured.
REMINDERS_ENABLED=false
# SMTP server hostname, required only when reminders are enabled.
SMTP_HOST=<smtp-host>
# SMTP server port, required only when reminders are enabled.
SMTP_PORT=587
# Secret: SMTP username.
SMTP_USERNAME=<smtp-username>
# Secret: SMTP password or provider app password.
SMTP_PASSWORD=<smtp-password>
# Whether the SMTP server requires authentication.
SMTP_AUTH=true
# Whether SMTP STARTTLS is enabled.
SMTP_STARTTLS_ENABLE=true
# Sender email address for task reminders.
REMINDER_EMAIL_FROM=<sender@example.com>
# Recipient email address for task reminders.
REMINDER_EMAIL_TO=<recipient@example.com>
# Keep mail health checks disabled when SMTP is not configured.
MANAGEMENT_HEALTH_MAIL_ENABLED=false
# Optional JVM tuning; the Docker image provides safe memory defaults.
JAVA_TOOL_OPTIONS=

# AI service (Render)
# HTTP port injected by the hosting platform.
PORT=8000
# Display label only; set to live for the hosted deployment.
APP_MODE=live
# Backend base URL, without an /api/v1 suffix.
BACKEND_URL=https://<your-backend>.onrender.com
# Exact Vercel production origin allowed by the AI service.
CORS_ORIGINS=https://<your-project>.vercel.app
# Primary hosted model provider.
LLM_PROVIDER=openai
# Optional provider fallback; leave empty to disable.
LLM_FALLBACK_PROVIDER=
# Ollama URL (unused for the hosted OpenAI-compatible provider).
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model (unused for the hosted OpenAI-compatible provider).
OLLAMA_MODEL=llama3.2:3b
# Ollama context size (unused for the hosted OpenAI-compatible provider).
OLLAMA_NUM_CTX=2048
# Ollama keep-alive duration (unused for the hosted provider).
OLLAMA_KEEP_ALIVE=30m
# Secret: Groq API key.
OPENAI_API_KEY=<groq-api-key>
# Select a current Groq chat model in its dashboard.
OPENAI_MODEL=<current-groq-chat-model>
# Groq OpenAI-compatible API base URL.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AI provider request timeout in seconds.
LLM_TIMEOUT_SECONDS=60
# Timeout for service health checks in seconds.
STATUS_TIMEOUT_SECONDS=20
# Maximum AI chat requests per client per minute.
RATE_LIMIT_PER_MINUTE=20
# AI service date/time zone.
TIMEZONE=Asia/Kolkata

# Frontend (Vercel build environment)
# Backend origin only; no /api/v1 suffix or trailing slash.
VITE_BACKEND_URL=https://<your-backend>.onrender.com
# AI service origin only; no /api/v1 suffix or trailing slash.
VITE_AI_SERVICE_URL=https://<your-ai-service>.onrender.com

# Docker Compose (LOCAL mode only; not used by Vercel or Render)
# Local Postgres database name.
POSTGRES_DB=<local-database>
# Local Postgres username.
POSTGRES_USER=<local-username>
# Secret: local Postgres password.
POSTGRES_PASSWORD=<local-password>
# Local backend host port.
BACKEND_PORT=8080
# Local AI service host port.
AI_SERVICE_PORT=8000
# Local frontend host port.
FRONTEND_PORT=3000
