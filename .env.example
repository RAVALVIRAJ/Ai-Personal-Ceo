# PostgreSQL (local development defaults)
POSTGRES_DB=ai_personal_ceo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Published service ports
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=3000

# Browser-visible API origins embedded in the frontend image
FRONTEND_BACKEND_URL=
FRONTEND_AI_SERVICE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# LLM configuration (Ollama runs on the host by default)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
TIMEZONE=Asia/Kolkata

# Reminder email (optional until reminders are used)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
REMINDER_EMAIL_FROM=
REMINDER_EMAIL_TO=
